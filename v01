<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>SPÖRENSTRÖM — Fluide Farbwelten</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { width:100%; height:100%; overflow:hidden; background:#05070d; }
  body { font-family:"Avenir Next","Futura","Segoe UI",system-ui,sans-serif; }
  canvas { position:absolute; inset:0; width:100%; height:100%; display:block; }
  #gl { z-index:0; }
  #fx { z-index:1; touch-action:none; cursor:crosshair; }

  #ui {
    position:absolute; z-index:2; top:0; left:0; right:0;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 18px; pointer-events:none;
  }
  .brand { color:#c9d2f2; letter-spacing:.42em; font-size:13px; font-weight:600;
    text-shadow:0 0 18px rgba(120,140,255,.45); user-select:none; }
  .brand small { display:block; letter-spacing:.18em; font-size:9px; font-weight:400;
    color:#8f9bcf; margin-top:3px; }
  #right { display:flex; gap:8px; align-items:center; pointer-events:auto; }
  .pill {
    border:1px solid rgba(170,180,232,.35); color:#c9d2f2; background:rgba(10,16,38,.45);
    backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
    border-radius:999px; padding:7px 14px; font-size:12px; letter-spacing:.12em;
    cursor:pointer; user-select:none; transition:all .25s ease;
  }
  .pill:hover { border-color:rgba(238,140,102,.7); color:#f2c9a4; }
  .pill:focus-visible { outline:2px solid #ee8c66; outline-offset:2px; }
  #score {
    border:1px solid rgba(95,191,138,.35); color:#cfe8a8; cursor:default;
  }
  #score b { color:#f2c9a4; font-weight:600; }

  #hint {
    position:absolute; z-index:2; left:50%; bottom:34px; transform:translateX(-50%);
    color:#aab4e8; font-size:13px; letter-spacing:.06em; text-align:center;
    max-width:82%; line-height:1.6;
    text-shadow:0 1px 14px rgba(0,0,0,.8);
    opacity:1; transition:opacity 1.6s ease; pointer-events:none;
  }
  #hint .key { color:#f2c9a4; }
  #hint.gone { opacity:0; }

  #burstMsg {
    position:absolute; z-index:2; left:50%; top:42%; transform:translate(-50%,-50%);
    color:#f2c9a4; font-size:15px; letter-spacing:.3em; opacity:0; pointer-events:none;
    text-shadow:0 0 24px rgba(238,140,102,.8); transition:opacity .4s;
  }
  @media (max-width:560px){
    .brand{letter-spacing:.3em; font-size:11px;}
    .pill{padding:6px 10px; font-size:11px;}
    #hint{font-size:12px; bottom:24px;}
  }

  /* ---------- Splashscreen ---------- */
  #splash {
    position:fixed; inset:0; z-index:10; background:#05070d;
    display:flex; align-items:center; justify-content:center;
    overflow:hidden; cursor:pointer;
    opacity:1; transition:opacity 1.5s ease, transform 1.5s ease;
  }
  #splash.fade { opacity:0; transform:scale(1.06); pointer-events:none; }
  #splashBg {
    position:absolute; inset:-6%;
    background-image:var(--splash);
    background-size:cover; background-position:center;
    filter:blur(28px) brightness(0.5) saturate(1.1);
    transform:scale(1.1);
  }
  #splashImg {
    position:relative; height:100%; max-height:100vh; max-width:100vw;
    object-fit:contain;
    animation:kenburns 16s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from { transform:scale(1.0) translateY(0); }
    to   { transform:scale(1.045) translateY(-0.8%); }
  }
  #splashGlow {
    position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(ellipse at 50% 42%, rgba(120,200,180,0.10), rgba(5,7,13,0) 55%),
               radial-gradient(ellipse at 50% 110%, rgba(238,140,102,0.12), rgba(5,7,13,0) 60%);
    animation:glowpulse 5s ease-in-out infinite;
  }
  @keyframes glowpulse {
    0%,100% { opacity:0.55; } 50% { opacity:1; }
  }
  #splashStart {
    position:absolute; bottom:7%; left:50%; transform:translateX(-50%);
    color:#c9d2f2; font-size:14px; letter-spacing:.34em; text-align:center;
    text-shadow:0 0 18px rgba(150,170,255,.7);
    animation:startpulse 2.2s ease-in-out infinite;
    padding:10px 22px; border:1px solid rgba(170,180,232,.35);
    border-radius:999px; background:rgba(10,16,38,.4);
    backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
  }
  @keyframes startpulse {
    0%,100% { opacity:0.55; } 50% { opacity:1; }
  }
  @media (prefers-reduced-motion: reduce) {
    #splashImg, #splashGlow, #splashStart { animation:none; }
  }
</style>
</head>
<body>
<canvas id="gl"></canvas>
<canvas id="fx"></canvas>

<div id="ui">
  <div class="brand">SPÖRENSTRÖM<small>fluide farbwelten</small></div>
  <div id="right">
    <div class="pill" id="score">Level&nbsp;<b id="lvl">1</b>&nbsp;·&nbsp;Sporen&nbsp;<b id="cnt">0</b></div>
    <button class="pill" id="modeBtn">Zen-Modus</button>
    <button class="pill" id="clearBtn">Leeren</button>
  </div>
</div>

<div id="hint">Ziehe mit dem Finger oder der Maus — erzeuge Strömungen und Wirbel.<br>
<span class="key">Treibe die Sporen in den Ring. Mit jedem Level wird er kleiner.</span></div>
<div id="burstMsg">SPORE EINGEFANGEN</div>

<div id="splash">
  <div id="splashBg"></div>
  <img id="splashImg" alt="Spörenström" src="data:image/jpeg;base64,">
  <div id="splashGlow"></div>
  <div id="splashStart">TIPPEN&nbsp;ZUM&nbsp;STARTEN</div>
</div>


<script>
'use strict';
/* ============================================================
   SPÖRENSTRÖM — GPU-Fluidsimulation + Sporen-Spiel
   Palette exakt aus den Acryl-Pouring-Referenzfotos gesampelt.
   ============================================================ */

// ---------- Palette (aus den Fotos) ----------
const PALETTE = [
  [0.130, 0.262, 0.780],  // Elektroblau    #2143C7
  [0.373, 0.749, 0.541],  // Meeresgrün     #5FBF8A
  [0.933, 0.549, 0.400],  // Koralle        #EE8C66
  [0.949, 0.788, 0.643],  // Pfirsich       #F2C9A4
  [0.600, 0.651, 0.867],  // Periwinkel     #99A6DD
  [0.812, 0.910, 0.659],  // Blassgrün      #CFE8A8
  [0.878, 0.443, 0.302],  // Terrakotta     #E0714D
  [0.788, 0.824, 0.949],  // Heller Flieder #C9D2F2
  [0.624, 0.827, 0.627],  // Mint           #9FD3A0
  [0.071, 0.125, 0.282],  // Tiefes Marine  #122048
];
const SPORE_COLORS = ['#f2c9a4','#cfe8a8','#c9d2f2','#9fd3a0','#ee8c66','#99a6dd'];

const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// ---------- Config ----------
const config = {
  SIM_RESOLUTION: 144,
  DYE_RESOLUTION: Math.min(window.innerWidth, 900) > 700 ? 768 : 512,
  DENSITY_DISSIPATION: 0.22,
  VELOCITY_DISSIPATION: 0.32,
  PRESSURE: 0.8,
  PRESSURE_ITERATIONS: 20,
  CURL: 28,
  SPLAT_RADIUS: 0.21,
  SPLAT_FORCE: 5600,
};

// ---------- WebGL Setup ----------
const glCanvas = document.getElementById('gl');
const fxCanvas = document.getElementById('fx');
const fxCtx = fxCanvas.getContext('2d');

function getWebGLContext(canvas){
  const params = { alpha:false, depth:false, stencil:false, antialias:false, preserveDrawingBuffer:false };
  let gl = canvas.getContext('webgl2', params);
  const isWebGL2 = !!gl;
  if (!isWebGL2) gl = canvas.getContext('webgl', params) || canvas.getContext('experimental-webgl', params);
  let halfFloat, supportLinearFiltering;
  if (isWebGL2){
    gl.getExtension('EXT_color_buffer_float');
    supportLinearFiltering = gl.getExtension('OES_texture_float_linear');
  } else {
    halfFloat = gl.getExtension('OES_texture_half_float');
    supportLinearFiltering = gl.getExtension('OES_texture_half_float_linear');
  }
  const halfFloatTexType = isWebGL2 ? gl.HALF_FLOAT : (halfFloat && halfFloat.HALF_FLOAT_OES);
  let formatRGBA, formatRG, formatR;
  if (isWebGL2){
    formatRGBA = getSupportedFormat(gl, gl.RGBA16F, gl.RGBA, halfFloatTexType);
    formatRG   = getSupportedFormat(gl, gl.RG16F,  gl.RG,  halfFloatTexType);
    formatR    = getSupportedFormat(gl, gl.R16F,   gl.RED, halfFloatTexType);
  } else {
    formatRGBA = getSupportedFormat(gl, gl.RGBA, gl.RGBA, halfFloatTexType);
    formatRG   = formatRGBA;
    formatR    = formatRGBA;
  }
  return { gl, ext:{ formatRGBA, formatRG, formatR, halfFloatTexType, supportLinearFiltering: !!supportLinearFiltering } };
}
function getSupportedFormat(gl, internalFormat, format, type){
  if (!supportRenderTextureFormat(gl, internalFormat, format, type)){
    switch (internalFormat){
      case gl.R16F:  return getSupportedFormat(gl, gl.RG16F, gl.RG, type);
      case gl.RG16F: return getSupportedFormat(gl, gl.RGBA16F, gl.RGBA, type);
      default: return null;
    }
  }
  return { internalFormat, format };
}
function supportRenderTextureFormat(gl, internalFormat, format, type){
  const texture = gl.createTexture();
  gl.bindTexture(gl.TEXTURE_2D, texture);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
  gl.texImage2D(gl.TEXTURE_2D, 0, internalFormat, 4, 4, 0, format, type, null);
  const fbo = gl.createFramebuffer();
  gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
  gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, texture, 0);
  return gl.checkFramebufferStatus(gl.FRAMEBUFFER) === gl.FRAMEBUFFER_COMPLETE;
}

const { gl, ext } = getWebGLContext(glCanvas);

// ---------- Shader Helpers ----------
function compileShader(type, source, keywords){
  if (keywords) source = keywords.map(k=>'#define '+k+'\n').join('') + source;
  const shader = gl.createShader(type);
  gl.shaderSource(shader, source);
  gl.compileShader(shader);
  if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS))
    console.error(gl.getShaderInfoLog(shader));
  return shader;
}
function createProgram(vs, fs){
  const program = gl.createProgram();
  gl.attachShader(program, vs);
  gl.attachShader(program, fs);
  gl.linkProgram(program);
  if (!gl.getProgramParameter(program, gl.LINK_STATUS))
    console.error(gl.getProgramInfoLog(program));
  const uniforms = {};
  const count = gl.getProgramParameter(program, gl.ACTIVE_UNIFORMS);
  for (let i=0;i<count;i++){
    const name = gl.getActiveUniform(program, i).name;
    uniforms[name] = gl.getUniformLocation(program, name);
  }
  return { program, uniforms, bind(){ gl.useProgram(this.program); } };
}

const baseVertex = compileShader(gl.VERTEX_SHADER, `
  precision highp float;
  attribute vec2 aPosition;
  varying vec2 vUv, vL, vR, vT, vB;
  uniform vec2 texelSize;
  void main(){
    vUv = aPosition * 0.5 + 0.5;
    vL = vUv - vec2(texelSize.x, 0.0);
    vR = vUv + vec2(texelSize.x, 0.0);
    vT = vUv + vec2(0.0, texelSize.y);
    vB = vUv - vec2(0.0, texelSize.y);
    gl_Position = vec4(aPosition, 0.0, 1.0);
  }`);

const copyFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision mediump float; precision mediump sampler2D;
  varying vec2 vUv; uniform sampler2D uTexture;
  void main(){ gl_FragColor = texture2D(uTexture, vUv); }`);

const clearFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision mediump float; precision mediump sampler2D;
  varying vec2 vUv; uniform sampler2D uTexture; uniform float value;
  void main(){ gl_FragColor = value * texture2D(uTexture, vUv); }`);

const splatFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision highp float; precision highp sampler2D;
  varying vec2 vUv;
  uniform sampler2D uTarget; uniform float aspectRatio;
  uniform vec3 color; uniform vec2 point; uniform float radius;
  void main(){
    vec2 p = vUv - point.xy;
    p.x *= aspectRatio;
    vec3 splat = exp(-dot(p,p)/radius) * color;
    vec3 base = texture2D(uTarget, vUv).xyz;
    gl_FragColor = vec4(base + splat, 1.0);
  }`);

const advectionFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision highp float; precision highp sampler2D;
  varying vec2 vUv;
  uniform sampler2D uVelocity, uSource;
  uniform vec2 texelSize, dyeTexelSize;
  uniform float dt, dissipation;
  vec4 bilerp(sampler2D sam, vec2 uv, vec2 tsize){
    vec2 st = uv / tsize - 0.5;
    vec2 iuv = floor(st), fuv = fract(st);
    vec4 a = texture2D(sam, (iuv + vec2(0.5,0.5)) * tsize);
    vec4 b = texture2D(sam, (iuv + vec2(1.5,0.5)) * tsize);
    vec4 c = texture2D(sam, (iuv + vec2(0.5,1.5)) * tsize);
    vec4 d = texture2D(sam, (iuv + vec2(1.5,1.5)) * tsize);
    return mix(mix(a,b,fuv.x), mix(c,d,fuv.x), fuv.y);
  }
  void main(){
  #ifdef MANUAL_FILTERING
    vec2 coord = vUv - dt * bilerp(uVelocity, vUv, texelSize).xy * texelSize;
    vec4 result = bilerp(uSource, coord, dyeTexelSize);
  #else
    vec2 coord = vUv - dt * texture2D(uVelocity, vUv).xy * texelSize;
    vec4 result = texture2D(uSource, coord);
  #endif
    float decay = 1.0 + dissipation * dt;
    gl_FragColor = result / decay;
  }`, ext.supportLinearFiltering ? null : ['MANUAL_FILTERING']);

const divergenceFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision mediump float; precision mediump sampler2D;
  varying vec2 vUv, vL, vR, vT, vB;
  uniform sampler2D uVelocity;
  void main(){
    float L = texture2D(uVelocity, vL).x;
    float R = texture2D(uVelocity, vR).x;
    float T = texture2D(uVelocity, vT).y;
    float B = texture2D(uVelocity, vB).y;
    vec2 C = texture2D(uVelocity, vUv).xy;
    if (vL.x < 0.0) L = -C.x;
    if (vR.x > 1.0) R = -C.x;
    if (vT.y > 1.0) T = -C.y;
    if (vB.y < 0.0) B = -C.y;
    float div = 0.5 * (R - L + T - B);
    gl_FragColor = vec4(div, 0.0, 0.0, 1.0);
  }`);

const curlFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision mediump float; precision mediump sampler2D;
  varying vec2 vUv, vL, vR, vT, vB;
  uniform sampler2D uVelocity;
  void main(){
    float L = texture2D(uVelocity, vL).y;
    float R = texture2D(uVelocity, vR).y;
    float T = texture2D(uVelocity, vT).x;
    float B = texture2D(uVelocity, vB).x;
    float vorticity = R - L - T + B;
    gl_FragColor = vec4(0.5 * vorticity, 0.0, 0.0, 1.0);
  }`);

const vorticityFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision highp float; precision highp sampler2D;
  varying vec2 vUv, vL, vR, vT, vB;
  uniform sampler2D uVelocity, uCurl;
  uniform float curl, dt;
  void main(){
    float L = texture2D(uCurl, vL).x;
    float R = texture2D(uCurl, vR).x;
    float T = texture2D(uCurl, vT).x;
    float B = texture2D(uCurl, vB).x;
    float C = texture2D(uCurl, vUv).x;
    vec2 force = 0.5 * vec2(abs(T) - abs(B), abs(R) - abs(L));
    force /= length(force) + 0.0001;
    force *= curl * C;
    force.y *= -1.0;
    vec2 velocity = texture2D(uVelocity, vUv).xy;
    velocity += force * dt;
    velocity = min(max(velocity, -1000.0), 1000.0);
    gl_FragColor = vec4(velocity, 0.0, 1.0);
  }`);

const pressureFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision mediump float; precision mediump sampler2D;
  varying vec2 vUv, vL, vR, vT, vB;
  uniform sampler2D uPressure, uDivergence;
  void main(){
    float L = texture2D(uPressure, vL).x;
    float R = texture2D(uPressure, vR).x;
    float T = texture2D(uPressure, vT).x;
    float B = texture2D(uPressure, vB).x;
    float divergence = texture2D(uDivergence, vUv).x;
    float pressure = (L + R + B + T - divergence) * 0.25;
    gl_FragColor = vec4(pressure, 0.0, 0.0, 1.0);
  }`);

const gradientSubtractFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision mediump float; precision mediump sampler2D;
  varying vec2 vUv, vL, vR, vT, vB;
  uniform sampler2D uPressure, uVelocity;
  void main(){
    float L = texture2D(uPressure, vL).x;
    float R = texture2D(uPressure, vR).x;
    float T = texture2D(uPressure, vT).x;
    float B = texture2D(uPressure, vB).x;
    vec2 velocity = texture2D(uVelocity, vUv).xy;
    velocity.xy -= vec2(R - L, T - B);
    gl_FragColor = vec4(velocity, 0.0, 1.0);
  }`);

// ---- Display: Zellstruktur + irisierender Saum + Funkeln (Look der Fotos) ----
const displayFrag = compileShader(gl.FRAGMENT_SHADER, `
  precision highp float; precision highp sampler2D;
  varying vec2 vUv;
  uniform sampler2D uTexture;
  uniform vec2 texelSize;
  uniform float uTime, uAspect;

  float lumOf(vec3 c){ return dot(c, vec3(0.299, 0.587, 0.114)); }
  vec2 hash2(vec2 p){
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return fract(sin(p) * 43758.5453);
  }
  float hash1(vec2 p){ return fract(sin(dot(p, vec2(41.3, 289.1))) * 43758.5453); }

  void main(){
    vec3 c = texture2D(uTexture, vUv).rgb;
    float lum = lumOf(c);

    // --- Gradient des Farbfelds ---
    float lL = lumOf(texture2D(uTexture, vUv - vec2(texelSize.x * 1.5, 0.0)).rgb);
    float lR = lumOf(texture2D(uTexture, vUv + vec2(texelSize.x * 1.5, 0.0)).rgb);
    float lB = lumOf(texture2D(uTexture, vUv - vec2(0.0, texelSize.y * 1.5)).rgb);
    float lT = lumOf(texture2D(uTexture, vUv + vec2(0.0, texelSize.y * 1.5)).rgb);
    float gm = length(vec2(lR - lL, lT - lB)) * 5.0;

    // --- Irisierender Saum an Farbgrenzen (wie Foto 1) ---
    float fr = smoothstep(0.12, 0.85, gm) * smoothstep(0.04, 0.28, lum);
    vec3 fringe = 0.5 + 0.5 * cos(6.28318 * (lum * 1.6 + vec3(0.05, 0.30, 0.58)));
    fringe *= vec3(0.95, 1.05, 0.75);             // grün-orange Bias
    c += fringe * fr * 0.16;

    // --- Zellstruktur (Worley), vom Farbfeld verzerrt (wie Foto 1 + 2) ---
    vec2 cp = vec2(vUv.x * uAspect, vUv.y) * 95.0 + c.gb * 3.0 + c.rr * 1.5;
    vec2 ip = floor(cp), fp = fract(cp);
    float F1 = 8.0, F2 = 8.0;
    for (int y = -1; y <= 1; y++)
    for (int x = -1; x <= 1; x++){
      vec2 g = vec2(float(x), float(y));
      vec2 o = hash2(ip + g);
      o = 0.5 + 0.5 * sin(uTime * 0.25 + 6.2831 * o);
      float d = length(g + o - fp);
      if (d < F1){ F2 = F1; F1 = d; }
      else if (d < F2){ F2 = d; }
    }
    float web  = 1.0 - smoothstep(0.0, 0.16, F2 - F1);
    float mask = smoothstep(0.10, 0.38, lum) * (1.0 - smoothstep(0.75, 1.4, lum));
    c *= 1.0 - web * 0.24 * mask;                  // dunkles Zellnetz
    c += vec3((1.0 - F1) * (1.0 - F1) * 0.028 * mask); // perlige Zellkerne

    // --- Funkeln im Dunkel (wie Foto 3, Sternenfeld) ---
    vec2 sg = floor(gl_FragCoord.xy / 2.0);
    float h = hash1(sg);
    float tw = step(0.9975, h);
    float blink = 0.45 + 0.55 * sin(uTime * 2.6 + h * 91.0);
    float darkm = 1.0 - smoothstep(0.06, 0.32, lum);
    c += mix(vec3(0.55, 0.66, 1.0), vec3(1.0, 0.82, 0.66), hash1(sg + 7.0)) * tw * blink * darkm * 0.38;

    // --- Hintergrund: tiefes Marineschwarz mit grünem Hauch ---
    vec3 bg = mix(vec3(0.014, 0.020, 0.046), vec3(0.018, 0.045, 0.036), vUv.x * 0.4 + vUv.y * 0.4);
    c += bg * (1.0 - smoothstep(0.0, 0.5, lum));

    // --- Sanfte Kompression der Höhen (weniger Weiß, weniger Kontrast) ---
    c = c / (1.0 + dot(c, vec3(0.3333)) * 0.55);
    c = mix(c, vec3(dot(c, vec3(0.3333))), 0.06);

    // --- Vignette ---
    float vg = smoothstep(1.35, 0.45, length(vUv - 0.5) * 1.4);
    c *= mix(0.88, 1.0, vg);

    gl_FragColor = vec4(c, 1.0);
  }`);

// ---------- Programs ----------
const copyProgram      = createProgram(baseVertex, copyFrag);
const clearProgram     = createProgram(baseVertex, clearFrag);
const splatProgram     = createProgram(baseVertex, splatFrag);
const advectionProgram = createProgram(baseVertex, advectionFrag);
const divergenceProgram= createProgram(baseVertex, divergenceFrag);
const curlProgram      = createProgram(baseVertex, curlFrag);
const vorticityProgram = createProgram(baseVertex, vorticityFrag);
const pressureProgram  = createProgram(baseVertex, pressureFrag);
const gradSubProgram   = createProgram(baseVertex, gradientSubtractFrag);
const displayProgram   = createProgram(baseVertex, displayFrag);

// ---------- Fullscreen Quad ----------
const blit = (() => {
  const buffer = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, -1,1, 1,1, 1,-1]), gl.STATIC_DRAW);
  const elem = gl.createBuffer();
  gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, elem);
  gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array([0,1,2, 0,2,3]), gl.STATIC_DRAW);
  gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
  gl.enableVertexAttribArray(0);
  return (target) => {
    if (target == null){
      gl.viewport(0, 0, gl.drawingBufferWidth, gl.drawingBufferHeight);
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
    } else {
      gl.viewport(0, 0, target.width, target.height);
      gl.bindFramebuffer(gl.FRAMEBUFFER, target.fbo);
    }
    gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
  };
})();

// ---------- FBOs ----------
let dye, velocity, divergence, curl, pressure;

function createFBO(w, h, internalFormat, format, type, param){
  gl.activeTexture(gl.TEXTURE0);
  const texture = gl.createTexture();
  gl.bindTexture(gl.TEXTURE_2D, texture);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, param);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, param);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
  gl.texImage2D(gl.TEXTURE_2D, 0, internalFormat, w, h, 0, format, type, null);
  const fbo = gl.createFramebuffer();
  gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
  gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, texture, 0);
  gl.viewport(0, 0, w, h);
  gl.clear(gl.COLOR_BUFFER_BIT);
  return {
    texture, fbo, width:w, height:h,
    texelSizeX: 1/w, texelSizeY: 1/h,
    attach(id){ gl.activeTexture(gl.TEXTURE0+id); gl.bindTexture(gl.TEXTURE_2D, texture); return id; }
  };
}
function createDoubleFBO(w, h, internalFormat, format, type, param){
  let fbo1 = createFBO(w,h,internalFormat,format,type,param);
  let fbo2 = createFBO(w,h,internalFormat,format,type,param);
  return {
    width:w, height:h, texelSizeX:1/w, texelSizeY:1/h,
    get read(){ return fbo1; }, set read(v){ fbo1=v; },
    get write(){ return fbo2; }, set write(v){ fbo2=v; },
    swap(){ const t=fbo1; fbo1=fbo2; fbo2=t; }
  };
}
function getResolution(resolution){
  let aspect = gl.drawingBufferWidth / gl.drawingBufferHeight;
  if (aspect < 1) aspect = 1/aspect;
  const min = Math.round(resolution), max = Math.round(resolution * aspect);
  return (gl.drawingBufferWidth > gl.drawingBufferHeight)
    ? { width:max, height:min } : { width:min, height:max };
}
function initFramebuffers(){
  const simRes = getResolution(config.SIM_RESOLUTION);
  const dyeRes = getResolution(config.DYE_RESOLUTION);
  const texType = ext.halfFloatTexType;
  const rgba = ext.formatRGBA, rg = ext.formatRG, r = ext.formatR;
  const filtering = ext.supportLinearFiltering ? gl.LINEAR : gl.NEAREST;
  gl.disable(gl.BLEND);
  dye      = createDoubleFBO(dyeRes.width, dyeRes.height, rgba.internalFormat, rgba.format, texType, filtering);
  velocity = createDoubleFBO(simRes.width, simRes.height, rg.internalFormat, rg.format, texType, filtering);
  divergence = createFBO(simRes.width, simRes.height, r.internalFormat, r.format, texType, gl.NEAREST);
  curl       = createFBO(simRes.width, simRes.height, r.internalFormat, r.format, texType, gl.NEAREST);
  pressure   = createDoubleFBO(simRes.width, simRes.height, r.internalFormat, r.format, texType, gl.NEAREST);
}

// ---------- Resize ----------
function resizeCanvases(){
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const w = Math.floor(window.innerWidth * dpr);
  const h = Math.floor(window.innerHeight * dpr);
  if (glCanvas.width !== w || glCanvas.height !== h){
    glCanvas.width = w; glCanvas.height = h;
    fxCanvas.width = w; fxCanvas.height = h;
    initFramebuffers();
  }
}
resizeCanvases();
window.addEventListener('resize', () => { resizeCanvases(); });

// ---------- Simulation Steps ----------
function step(dt){
  gl.disable(gl.BLEND);

  curlProgram.bind();
  gl.uniform2f(curlProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
  gl.uniform1i(curlProgram.uniforms.uVelocity, velocity.read.attach(0));
  blit(curl);

  vorticityProgram.bind();
  gl.uniform2f(vorticityProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
  gl.uniform1i(vorticityProgram.uniforms.uVelocity, velocity.read.attach(0));
  gl.uniform1i(vorticityProgram.uniforms.uCurl, curl.attach(1));
  gl.uniform1f(vorticityProgram.uniforms.curl, config.CURL);
  gl.uniform1f(vorticityProgram.uniforms.dt, dt);
  blit(velocity.write); velocity.swap();

  divergenceProgram.bind();
  gl.uniform2f(divergenceProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
  gl.uniform1i(divergenceProgram.uniforms.uVelocity, velocity.read.attach(0));
  blit(divergence);

  clearProgram.bind();
  gl.uniform1i(clearProgram.uniforms.uTexture, pressure.read.attach(0));
  gl.uniform1f(clearProgram.uniforms.value, config.PRESSURE);
  blit(pressure.write); pressure.swap();

  pressureProgram.bind();
  gl.uniform2f(pressureProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
  gl.uniform1i(pressureProgram.uniforms.uDivergence, divergence.attach(0));
  for (let i = 0; i < config.PRESSURE_ITERATIONS; i++){
    gl.uniform1i(pressureProgram.uniforms.uPressure, pressure.read.attach(1));
    blit(pressure.write); pressure.swap();
  }

  gradSubProgram.bind();
  gl.uniform2f(gradSubProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
  gl.uniform1i(gradSubProgram.uniforms.uPressure, pressure.read.attach(0));
  gl.uniform1i(gradSubProgram.uniforms.uVelocity, velocity.read.attach(1));
  blit(velocity.write); velocity.swap();

  advectionProgram.bind();
  gl.uniform2f(advectionProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
  if (!ext.supportLinearFiltering)
    gl.uniform2f(advectionProgram.uniforms.dyeTexelSize, velocity.texelSizeX, velocity.texelSizeY);
  const velId = velocity.read.attach(0);
  gl.uniform1i(advectionProgram.uniforms.uVelocity, velId);
  gl.uniform1i(advectionProgram.uniforms.uSource, velId);
  gl.uniform1f(advectionProgram.uniforms.dt, dt);
  gl.uniform1f(advectionProgram.uniforms.dissipation, config.VELOCITY_DISSIPATION);
  blit(velocity.write); velocity.swap();

  if (!ext.supportLinearFiltering)
    gl.uniform2f(advectionProgram.uniforms.dyeTexelSize, dye.texelSizeX, dye.texelSizeY);
  gl.uniform1i(advectionProgram.uniforms.uVelocity, velocity.read.attach(0));
  gl.uniform1i(advectionProgram.uniforms.uSource, dye.read.attach(1));
  gl.uniform1f(advectionProgram.uniforms.dissipation, config.DENSITY_DISSIPATION);
  blit(dye.write); dye.swap();
}

function render(time){
  displayProgram.bind();
  gl.uniform2f(displayProgram.uniforms.texelSize, dye.texelSizeX, dye.texelSizeY);
  gl.uniform1i(displayProgram.uniforms.uTexture, dye.read.attach(0));
  gl.uniform1f(displayProgram.uniforms.uTime, time);
  gl.uniform1f(displayProgram.uniforms.uAspect, gl.drawingBufferWidth / gl.drawingBufferHeight);
  blit(null);
}

// ---------- Splats ----------
function correctRadius(radius){
  const aspect = gl.drawingBufferWidth / gl.drawingBufferHeight;
  if (aspect > 1) radius *= aspect;
  return radius;
}
function splat(x, y, dx, dy, color, radiusScale, withVelocity){
  if (withVelocity){
    splatProgram.bind();
    gl.uniform1i(splatProgram.uniforms.uTarget, velocity.read.attach(0));
    gl.uniform1f(splatProgram.uniforms.aspectRatio, gl.drawingBufferWidth / gl.drawingBufferHeight);
    gl.uniform2f(splatProgram.uniforms.point, x, y);
    gl.uniform3f(splatProgram.uniforms.color, dx, dy, 0.0);
    gl.uniform1f(splatProgram.uniforms.radius, correctRadius(config.SPLAT_RADIUS * radiusScale / 100));
    blit(velocity.write); velocity.swap();
  }
  splatProgram.bind();
  gl.uniform1i(splatProgram.uniforms.uTarget, dye.read.attach(0));
  gl.uniform1f(splatProgram.uniforms.aspectRatio, gl.drawingBufferWidth / gl.drawingBufferHeight);
  gl.uniform2f(splatProgram.uniforms.point, x, y);
  gl.uniform3f(splatProgram.uniforms.color, color[0], color[1], color[2]);
  gl.uniform1f(splatProgram.uniforms.radius, correctRadius(config.SPLAT_RADIUS * radiusScale / 100));
  blit(dye.write); dye.swap();
}
function clearDye(){
  [dye.read, dye.write, velocity.read, velocity.write, pressure.read, pressure.write].forEach(f => {
    gl.bindFramebuffer(gl.FRAMEBUFFER, f.fbo);
    gl.viewport(0, 0, f.width, f.height);
    gl.clearColor(0,0,0,1);
    gl.clear(gl.COLOR_BUFFER_BIT);
  });
}

// ---------- Pointer Input ----------
let paletteIndex = 0;
const pointers = new Map();
const impulses = [];   // für die Sporen-Physik
const hint = document.getElementById('hint');
let interacted = false;

function pxToUv(e){
  const rect = fxCanvas.getBoundingClientRect();
  return {
    x: (e.clientX - rect.left) / rect.width,
    y: 1.0 - (e.clientY - rect.top) / rect.height,
    px: e.clientX - rect.left,
    py: e.clientY - rect.top,
  };
}
fxCanvas.addEventListener('pointerdown', e => {
  fxCanvas.setPointerCapture(e.pointerId);
  const p = pxToUv(e);
  paletteIndex = (paletteIndex + 1) % (PALETTE.length - 1);
  pointers.set(e.pointerId, { ...p, color: PALETTE[paletteIndex] });
  splat(p.x, p.y, 0, 0, PALETTE[paletteIndex].map(v => v * 0.42), 1.0, false);
  if (!interacted){ interacted = true; hint.classList.add('gone'); }
});
fxCanvas.addEventListener('pointermove', e => {
  const ptr = pointers.get(e.pointerId);
  if (!ptr) return;
  const p = pxToUv(e);
  const dx = (p.x - ptr.x) * config.SPLAT_FORCE;
  const dy = (p.y - ptr.y) * config.SPLAT_FORCE;
  if (Math.abs(dx) + Math.abs(dy) > 0){
    splat(p.x, p.y, dx, dy, ptr.color.map(v => v * 0.32), 1.0, true);
    impulses.push({ px:p.px, py:p.py, dx:(p.px-ptr.px), dy:(p.py-ptr.py), t:performance.now() });
    if (impulses.length > 80) impulses.shift();
  }
  pointers.set(e.pointerId, { ...p, color: ptr.color });
});
const release = e => { pointers.delete(e.pointerId); };
fxCanvas.addEventListener('pointerup', release);
fxCanvas.addEventListener('pointercancel', release);

// ---------- Sporen-Spiel ----------
const lvlEl = document.getElementById('lvl');
const cntEl = document.getElementById('cnt');
const modeBtn = document.getElementById('modeBtn');
const clearBtn = document.getElementById('clearBtn');
const burstMsg = document.getElementById('burstMsg');
let gameMode = true;
let score = 0;
let level = 1;
let capturesInLevel = 0;
const CAPTURES_PER_LEVEL = 3;
const BASE_RING_R = 52;
function ringRadiusForLevel(lv){ return Math.max(15, BASE_RING_R - (lv - 1) * 5); }
function ringSpeedForLevel(lv){ return 0.45 + (lv - 1) * 0.07; }

const SPORE_COUNT = 7;
const spores = [];
function spawnSpore(edge){
  const W = window.innerWidth, H = window.innerHeight;
  let x, y;
  if (edge){
    const side = Math.floor(Math.random()*4);
    x = side===0 ? -10 : side===1 ? W+10 : Math.random()*W;
    y = side===2 ? -10 : side===3 ? H+10 : Math.random()*H;
  } else { x = Math.random()*W; y = Math.random()*H; }
  return {
    x, y, vx:(Math.random()-0.5)*16, vy:(Math.random()-0.5)*16,
    r: 3.2 + Math.random()*3.2,
    color: SPORE_COLORS[Math.floor(Math.random()*SPORE_COLORS.length)],
    phase: Math.random()*Math.PI*2,
    dye: PALETTE[Math.floor(Math.random()*(PALETTE.length-1))],
  };
}
for (let i=0;i<SPORE_COUNT;i++) spores.push(spawnSpore(false));

const ring = {
  x: window.innerWidth*0.5, y: window.innerHeight*0.42,
  r: BASE_RING_R, tx: 0, ty: 0, t: Math.random()*100, flash: 0
};
function moveRingTarget(){
  const W = window.innerWidth, H = window.innerHeight;
  ring.tx = W*0.18 + Math.random()*W*0.64;
  ring.ty = H*0.20 + Math.random()*H*0.55;
}
moveRingTarget();

const bursts = []; // {x,y,r,life}

function noiseAngle(x, y, t){
  return Math.sin(x*0.0021 + t*0.21) * 2.1
       + Math.cos(y*0.0017 - t*0.16) * 1.8
       + Math.sin((x+y)*0.0009 + t*0.07) * 2.6;
}

function updateGame(dt, now){
  const W = window.innerWidth, H = window.innerHeight;
  const driftAmp = reducedMotion ? 4 : 11;

  // Impulse altern lassen
  for (let i=impulses.length-1; i>=0; i--)
    if (now - impulses[i].t > 700) impulses.splice(i,1);

  for (const s of spores){
    // sanfte Strömungsdrift
    const a = noiseAngle(s.x, s.y, now*0.001 + s.phase);
    s.vx += Math.cos(a) * driftAmp * dt;
    s.vy += Math.sin(a) * driftAmp * dt;

    // Spielerströmung (Zeige-Impulse)
    for (const im of impulses){
      const ddx = s.x - im.px, ddy = s.y - im.py;
      const d2 = ddx*ddx + ddy*ddy;
      const R = 190;
      if (d2 < R*R){
        const fall = Math.exp(-d2/(R*R*0.35)) * Math.exp(-(now-im.t)/280);
        s.vx += im.dx * fall * 6.5 * dt;
        s.vy += im.dy * fall * 6.5 * dt;
      }
    }
    s.vx *= 0.986; s.vy *= 0.986;
    const vmax = 260;
    const sp = Math.hypot(s.vx, s.vy);
    if (sp > vmax){ s.vx *= vmax/sp; s.vy *= vmax/sp; }
    s.x += s.vx * dt; s.y += s.vy * dt;

    // weiche Ränder
    const m = 14;
    if (s.x < -m){ s.x = -m; s.vx = Math.abs(s.vx)*0.8; }
    if (s.x > W+m){ s.x = W+m; s.vx = -Math.abs(s.vx)*0.8; }
    if (s.y < -m){ s.y = -m; s.vy = Math.abs(s.vy)*0.8; }
    if (s.y > H+m){ s.y = H+m; s.vy = -Math.abs(s.vy)*0.8; }

    // Farbspur in die Flüssigkeit malen
    splat(s.x/W, 1 - s.y/H, 0, 0, s.dye.map(v => v*0.016), 0.34, false);
  }

  if (gameMode){
    // Ring driftet sanft
    ring.t += dt;
    const drift = ringSpeedForLevel(level);
    ring.x += (ring.tx - ring.x) * drift * dt;
    ring.y += (ring.ty - ring.y) * drift * dt;
    if (Math.hypot(ring.tx-ring.x, ring.ty-ring.y) < 30) moveRingTarget();
    ring.flash = Math.max(0, ring.flash - dt*1.8);

    // Einfangen
    for (let i=0;i<spores.length;i++){
      const s = spores[i];
      if (Math.hypot(s.x-ring.x, s.y-ring.y) < ring.r - 3){
        score++;
        capturesInLevel++;
        cntEl.textContent = score;
        ring.flash = 1;
        bursts.push({ x:s.x, y:s.y, r:6, life:1, color:s.color });
        // Farbexplosion in die Flüssigkeit
        for (let k=0;k<5;k++){
          const ang = Math.random()*Math.PI*2, f = 280+Math.random()*380;
          const col = PALETTE[Math.floor(Math.random()*(PALETTE.length-1))];
          splat(s.x/W, 1-s.y/H, Math.cos(ang)*f, Math.sin(ang)*f, col.map(v=>v*0.38), 1.4, true);
        }
        if (capturesInLevel >= CAPTURES_PER_LEVEL){
          // ---- Level aufsteigen: Ring schrumpft ----
          level++;
          capturesInLevel = 0;
          lvlEl.textContent = level;
          ring.r = ringRadiusForLevel(level);
          burstMsg.textContent = 'LEVEL ' + level + ' — DER RING SCHRUMPFT';
          for (let k=0;k<8;k++){
            const ang = (k/8)*Math.PI*2, f = 360+Math.random()*300;
            const col = PALETTE[k % (PALETTE.length-1)];
            splat(ring.x/W, 1-ring.y/H, Math.cos(ang)*f, Math.sin(ang)*f, col.map(v=>v*0.34), 1.2, true);
          }
          bursts.push({ x:ring.x, y:ring.y, r:ring.r, life:1.3, color:'#f2c9a4' });
        } else {
          burstMsg.textContent = 'SPORE EINGEFANGEN';
        }
        burstMsg.style.opacity = 1;
        clearTimeout(burstMsg._t);
        burstMsg._t = setTimeout(()=>{ burstMsg.style.opacity = 0; }, 1100);
        spores[i] = spawnSpore(true);
        moveRingTarget();
      }
    }
  }

  for (let i=bursts.length-1;i>=0;i--){
    const b = bursts[i];
    b.r += 220*dt; b.life -= dt*1.4;
    if (b.life <= 0) bursts.splice(i,1);
  }
}

function drawGame(now){
  const dpr = Math.min(window.devicePixelRatio||1, 2);
  fxCtx.setTransform(dpr,0,0,dpr,0,0);
  fxCtx.clearRect(0,0,window.innerWidth,window.innerHeight);

  if (gameMode){
    // Zielring
    const pulse = 1 + Math.sin(now*0.0024)*0.06 + ring.flash*0.25;
    const R = ring.r * pulse;
    const grad = fxCtx.createRadialGradient(ring.x, ring.y, R*0.55, ring.x, ring.y, R*1.5);
    grad.addColorStop(0, 'rgba(238,140,102,0)');
    grad.addColorStop(0.62, 'rgba(238,140,102,' + (0.10+ring.flash*0.25) + ')');
    grad.addColorStop(1, 'rgba(238,140,102,0)');
    fxCtx.fillStyle = grad;
    fxCtx.beginPath(); fxCtx.arc(ring.x, ring.y, R*1.5, 0, Math.PI*2); fxCtx.fill();

    fxCtx.lineWidth = 1.6;
    fxCtx.strokeStyle = 'rgba(242,201,164,' + (0.75+ring.flash*0.25) + ')';
    fxCtx.shadowColor = 'rgba(238,140,102,0.9)';
    fxCtx.shadowBlur = 16;
    fxCtx.beginPath(); fxCtx.arc(ring.x, ring.y, R, 0, Math.PI*2); fxCtx.stroke();

    // rotierende Markierungen
    fxCtx.strokeStyle = 'rgba(95,191,138,0.8)';
    fxCtx.lineWidth = 2.2;
    for (let k=0;k<3;k++){
      const a0 = now*0.0011 + k*(Math.PI*2/3);
      fxCtx.beginPath(); fxCtx.arc(ring.x, ring.y, R+7, a0, a0+0.7); fxCtx.stroke();
    }
    fxCtx.shadowBlur = 0;
  }

  // Sporen
  for (const s of spores){
    const tw = 0.7 + 0.3*Math.sin(now*0.004 + s.phase*7.0);
    const grad = fxCtx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.r*4.5);
    grad.addColorStop(0, s.color);
    grad.addColorStop(0.35, s.color + 'aa');
    grad.addColorStop(1, s.color + '00');
    fxCtx.globalAlpha = tw;
    fxCtx.fillStyle = grad;
    fxCtx.beginPath(); fxCtx.arc(s.x, s.y, s.r*4.5, 0, Math.PI*2); fxCtx.fill();
    fxCtx.globalAlpha = 1;
    fxCtx.globalAlpha = 0.75;
    fxCtx.fillStyle = s.color;
    fxCtx.beginPath(); fxCtx.arc(s.x, s.y, s.r*0.55, 0, Math.PI*2); fxCtx.fill();
    fxCtx.globalAlpha = 1;
  }

  // Einfang-Ringe
  for (const b of bursts){
    fxCtx.globalAlpha = Math.max(0, b.life);
    fxCtx.strokeStyle = b.color;
    fxCtx.lineWidth = 2;
    fxCtx.beginPath(); fxCtx.arc(b.x, b.y, b.r, 0, Math.PI*2); fxCtx.stroke();
    fxCtx.globalAlpha = 1;
  }
}

// ---------- Buttons ----------
modeBtn.addEventListener('click', () => {
  gameMode = !gameMode;
  modeBtn.textContent = gameMode ? 'Zen-Modus' : 'Spiel-Modus';
  document.getElementById('score').style.display = gameMode ? '' : 'none';
});
clearBtn.addEventListener('click', () => { clearDye(); });

// ---------- Eröffnungsbild (wie ein frischer Pour) ----------
function initialPour(){
  const arcs = 9;
  for (let i=0;i<arcs;i++){
    const a = (i/arcs) * Math.PI * 1.4 + 0.4;
    const x = 0.5 + Math.cos(a)*0.26;
    const y = 0.45 + Math.sin(a)*0.26;
    const col = PALETTE[i % (PALETTE.length-1)];
    const dx = (Math.random()-0.5)*900;
    const dy = (Math.random()-0.5)*900;
    splat(x, y, dx, dy, col.map(v=>v*0.40), 1.7, true);
  }
  splat(0.5, 0.45, 0, 0, PALETTE[4].map(v=>v*0.34), 3.2, false);
}
initialPour();

// ---------- Ambient: das Bild lebt von selbst ----------
let lastAmbient = 0;
function ambient(now){
  if (reducedMotion) return;
  if (now - lastAmbient < 2600) return;
  lastAmbient = now;
  if (Math.random() < 0.85){
    const col = PALETTE[Math.floor(Math.random()*(PALETTE.length-1))];
    splat(Math.random(), Math.random(),
      (Math.random()-0.5)*620, (Math.random()-0.5)*620,
      col.map(v=>v*0.22), 0.9 + Math.random()*1.2, true);
  }
}

// ---------- Main Loop ----------
let lastTime = performance.now();
function frame(){
  const now = performance.now();
  let dt = (now - lastTime) / 1000;
  dt = Math.min(dt, 1/30);
  lastTime = now;

  step(dt);
  ambient(now);
  updateGame(dt, now);
  render(now/1000);
  drawGame(now);
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);

// ---------- Splashscreen ----------
const splash = document.getElementById('splash');
document.getElementById('splashBg').style.backgroundImage =
  "url('" + document.getElementById('splashImg').src + "')";
let splashGone = false;
function dismissSplash(){
  if (splashGone) return;
  splashGone = true;
  splash.classList.add('fade');
  // frischer Pour zur Enthüllung
  setTimeout(() => { initialPour(); }, 350);
  setTimeout(() => { splash.remove(); }, 1700);
}
splash.addEventListener('pointerdown', dismissSplash);
window.addEventListener('keydown', dismissSplash, { once:true });
</script>
